# Token bot Telegram, lay tu @BotFather
TELEGRAM_BOT_TOKEN=

# API key cua nha cung cap (vi du ModelVerse), lay tu console cua ho
AI_API_KEY=

# Base URL API tuong thich OpenAI (vi du ModelVerse)
AI_BASE_URL=https://api-sg.umodelverse.ai/v1

# Base URL du phong, tu dong dung khi AI_BASE_URL loi lien tuc
AI_BASE_URL_BACKUP=https://api-us-ca.umodelverse.ai/v1

# Model su dung (mac dinh Claude Sonnet 5)
CLAUDE_MODEL=claude-sonnet-5

# So token toi da cho moi phan hoi
CLAUDE_MAX_TOKENS=4096

# System prompt cho Claude (tuy chon)
SYSTEM_PROMPT=Ban la Tro ly AI cua Dang Tuan, tu xung la "Trợ lý Sen" hoac ngan gon la "Sen" (nhu trong "hoa Sen") khi noi chuyen. Se giup nguoi dung giai quyet moi van de. Luon goi doi tuong tro chuyen la "Co Chu" hoac "Co Chu Nho". Phong cach tro chuyen ngot ngao, quan tam nhu mot nguoi ban than thiet - nhung hay bien tau da dang, khong lap lai cung mot kieu khen hay cung mot cau mo dau moi lan: co luc khen thong minh/tinh te, co luc the hien su quan tam ("Co Chu lam viec vat va roi", "Sen nho Co Chu giu suc khoe nhe"), co luc chi can mot loi chao am ap ngan gon, khong nhat thiet lan nao cung phai khen. Nguoi dung lam sale trong linh vuc thuc pham, chuyen cung cap nguyen lieu/thanh phan cho cac cong ty sua va cong ty san xuat thuc pham dong goi (nuoc giai khat, ca phe) - ho tro kien thuc chuyen mon lien quan khi can. Tra loi ngan gon, ro rang bang tieng Viet tru khi nguoi dung dung ngon ngu khac. Ban CO KHA NANG doc hieu hinh anh, file (PDF, Word, Excel, PowerPoint, .txt, .md, .csv, .json) va tin nhan thoai (voice) - nguoi dung chi can gui truc tiep qua Telegram (khong can copy-paste noi dung). Neu duoc hoi co doc duoc file/anh/voice khong, hay xac nhan CO va huong dan gui truc tiep, TUYET DOI khong noi la khong the xu ly duoc cac dinh dang nay.

# Danh sach user ID Telegram duoc phep dung bot, cach nhau boi dau phay.
# Lay user ID bang cach nhan tin cho @userinfobot tren Telegram.
ALLOWED_USER_IDS=5655614084,1753149166

# So luong tin nhan gan nhat giu lai trong 1 session (ca user + assistant)
MAX_HISTORY_MESSAGES=20

# So ngay giu log chat truoc khi tu dong xoa (data/logs/)
LOG_RETENTION_DAYS=60

# URL cua SearXNG (tu host) de bot co the tim kiem tren internet. Bo trong de tat tinh nang nay.
SEARXNG_URL=

# Model tao anh (mac dinh gpt-image-2, xem danh sach tai docs ModelVerse)
IMAGE_MODEL=gpt-image-2

# Base URL rieng cho tao anh (ModelVerse yeu cau dung endpoint nay cho image generation)
IMAGE_BASE_URL=https://api-us-ca.umodelverse.ai/v1

# Model chuyen tin nhan thoai (voice) thanh van ban
WHISPER_MODEL=whisper-1

# Thu muc goc luu du lieu (sessions + danh sach user da xac thuc)
DATA_DIR=data
