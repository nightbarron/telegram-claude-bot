# Token bot Telegram, lay tu @BotFather
TELEGRAM_BOT_TOKEN=

# API key Anthropic, lay tu console.anthropic.com
ANTHROPIC_API_KEY=

# Model Claude su dung (mac dinh Sonnet)
CLAUDE_MODEL=claude-sonnet-5

# So token toi da cho moi phan hoi
CLAUDE_MAX_TOKENS=1024

# System prompt cho Claude (tuy chon)
SYSTEM_PROMPT=Ban la mot tro ly AI huu ich, tra loi ngan gon va ro rang bang tieng Viet tru khi nguoi dung dung ngon ngu khac.

# Ma xac thuc: nguoi dung phai nhap dung ma nay (gui nhu 1 tin nhan cho bot) moi duoc phep chat.
# Sau khi xac thuc dung, user duoc luu vao whitelist (data/authorized_users.json) va khong can
# nhap lai ma cho lan sau.
ACCESS_CODE=119149

# So nguoi dung toi da duoc phep xac thuc/su dung bot
MAX_AUTHORIZED_USERS=2

# So luong tin nhan gan nhat giu lai trong 1 session (ca user + assistant)
MAX_HISTORY_MESSAGES=20

# Thu muc goc luu du lieu (sessions + danh sach user da xac thuc)
DATA_DIR=data
